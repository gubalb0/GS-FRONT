# ===== IA (LLM) =====
# "mock" = modo demonstração (regras, sem chave). Para IA real use "openai_compat".
LLM_PROVIDER=openai_compat
LLM_API_KEY=coloque-sua-chave-aqui
# Groq (gratuito): https://api.groq.com/openai/v1  | modelo: llama-3.3-70b-versatile
# Gemini:          https://generativelanguage.googleapis.com/v1beta/openai | modelo: gemini-2.0-flash
# OpenAI:          https://api.openai.com/v1 | modelo: gpt-4o-mini
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=25

# ===== Segurança =====
# Origens do front separadas por vírgula. Nunca use * em produção.
ALLOWED_ORIGINS=http://localhost:8501
MANAGER_PASSWORD=defina-uma-senha-forte
TOKEN_SECRET=gere-um-valor-aleatorio-longo

# ===== Dados =====
DATABASE_PATH=data/zelo.db
SEED_DEMO_DATA=true
ENABLE_EXTERNAL_DATA=true
